# FRIDAY API Keys
# Copy this file to .env and fill in your actual API keys
# NEVER commit .env to git - it's in .gitignore

# Gemini API Keys for Google Search Grounding
# Multiple keys supported for automatic failover/rotation
GEMINI_API_KEY=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=

# Optional: Per-key model overrides
# If not specified, the provider uses the default model (gemini-2.5-flash)
# Example: GEMINI_MODEL_1=gemini-3.5-flash
GEMINI_MODEL_1=
GEMINI_MODEL_2=